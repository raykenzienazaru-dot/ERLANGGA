# AGRAPATHA Backend Gateway Configuration
# Base URL for the backend gateway (defaults to same-origin relative path /api)
# In local development, /api and /health are proxied to http://localhost:3000 via Vite dev server
VITE_GATEWAY_BASE_URL=

# BMKG Regional Gateway Base URL (optional proxy override; defaults to /api/bmkg)
VITE_BMKG_BASE_URL=

# AGRAPATHA Vision Inference Configuration
# Deployed Wildfire MobileNetV2 inference API (FastAPI)
VITE_VISION_API_BASE_URL=https://tes-tflite-production.up.railway.app

# Leaf Disease inference API Base URL (unconfigured / pending backend deployment)
VITE_LEAF_API_BASE_URL=
