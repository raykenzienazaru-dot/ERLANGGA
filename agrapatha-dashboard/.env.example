# AGRAPATHA Vision Inference Configuration
# Deployed Wildfire MobileNetV2 inference API (FastAPI)
VITE_VISION_API_BASE_URL=https://tes-tflite-production.up.railway.app

# Leaf Disease inference API Base URL (unconfigured / pending backend deployment)
VITE_LEAF_API_BASE_URL=

# BMKG Regional Gateway Base URL (optional proxy)
VITE_BMKG_BASE_URL=

# ==============================================================================
# EMQX Cloud MQTT Broker Configuration
# ==============================================================================
# IMPORTANT PORT ADAPTATION / DISTINCTION:
# - Web Browser Dashboard: Uses WebSocket over TLS/SSL (WSS) on PORT 8084.
#   (Browsers cannot open direct TCP sockets to port 8883)
# - ESP32 / ESP32-CAM Hardware: Uses Native TCP over TLS/SSL on PORT 8883.
# ==============================================================================
VITE_MQTT_BROKER_URL=wss://wfc1ec11.ala.asia-southeast1.emqxsl.com:8084/mqtt
VITE_MQTT_HOST=wfc1ec11.ala.asia-southeast1.emqxsl.com
VITE_MQTT_WS_PORT=8084
VITE_MQTT_TCP_PORT=8883
VITE_MQTT_WS_PATH=/mqtt

# Optional authentication credentials (configured in EMQX Cloud Console)
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=

# Standard Topic Namespaces
VITE_MQTT_TOPIC_TELEMETRY=agrapatha/telemetry
VITE_MQTT_TOPIC_COMMANDS=agrapatha/commands
VITE_MQTT_TOPIC_STATUS=agrapatha/status
